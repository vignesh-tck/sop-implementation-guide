# Copy this file to .env and fill in your values
# Never commit .env to git

# Supabase — Settings > API in your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic — for LLM extraction in agents
ANTHROPIC_API_KEY=your-anthropic-key-here
# Set to false on corporate networks with SSL inspection (self-signed certificate errors)
ANTHROPIC_SSL_VERIFY=true

# App
APP_ENV=development
LOG_LEVEL=INFO
